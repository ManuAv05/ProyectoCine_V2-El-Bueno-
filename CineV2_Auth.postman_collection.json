{
	"info": {
		"_postman_id": "cine-v2-security-full",
		"name": "CineV2 - Security Completa",
		"description": "Flujo completo: Register → Login → Crear Rol ADMIN → Crear Usuario ADMIN → Login ADMIN → Probar rutas",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "base_url", "value": "http://localhost:8081"},
		{"key": "user_token", "value": ""},
		{"key": "admin_token", "value": ""}
	],
	"item": [
		{
			"name": "1. Setup",
			"item": [
				{
					"name": "1.1 Register USER",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"user@cine.com\",\n  \"password\": \"1234\"\n}"},
						"url": {"raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"]}
					}
				},
				{
					"name": "1.2 Login USER (guarda token)",
					"event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "pm.collectionVariables.set('user_token', json.token);", "console.log('Token USER guardado');"], "type": "text/javascript"}}],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"user@cine.com\",\n  \"password\": \"1234\"\n}"},
						"url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
					}
				},
				{
					"name": "1.3 Crear Rol ADMIN",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{user_token}}"}],
						"body": {"mode": "raw", "raw": "{\n  \"nombre\": \"ADMIN\"\n}"},
						"url": {"raw": "{{base_url}}/api/v1/roles", "host": ["{{base_url}}"], "path": ["api", "v1", "roles"]}
					}
				},
				{
					"name": "1.4 Crear Usuario ADMIN",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{user_token}}"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\",\n  \"roles\": [\"ADMIN\"]\n}"},
						"url": {"raw": "{{base_url}}/api/v1/usuarios", "host": ["{{base_url}}"], "path": ["api", "v1", "usuarios"]}
					}
				},
				{
					"name": "1.5 Login ADMIN (guarda token)",
					"event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "pm.collectionVariables.set('admin_token', json.token);", "console.log('Token ADMIN guardado');"], "type": "text/javascript"}}],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\"\n}"},
						"url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
					}
				}
			]
		},
		{
			"name": "2. Tests Seguridad",
			"item": [
				{
					"name": "2.1 Publico SIN token → 200",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/v1/test/publico", "host": ["{{base_url}}"], "path": ["api", "v1", "test", "publico"]}
					}
				},
				{
					"name": "2.2 Admin SIN token → 403",
					"request": {
						"method": "GET",
						"url": {"raw": "{{base_url}}/api/v1/test/admin", "host": ["{{base_url}}"], "path": ["api", "v1", "test", "admin"]}
					}
				},
				{
					"name": "2.3 Admin CON token USER → 403",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{user_token}}"}],
						"url": {"raw": "{{base_url}}/api/v1/test/admin", "host": ["{{base_url}}"], "path": ["api", "v1", "test", "admin"]}
					}
				},
				{
					"name": "2.4 Admin CON token ADMIN → 200 ✅",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
						"url": {"raw": "{{base_url}}/api/v1/test/admin", "host": ["{{base_url}}"], "path": ["api", "v1", "test", "admin"]}
					}
				},
				{
					"name": "2.5 Login incorrecto → 401",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {"mode": "raw", "raw": "{\n  \"email\": \"user@cine.com\",\n  \"password\": \"wrongpass\"\n}"},
						"url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
					}
				}
			]
		}
	]
}
